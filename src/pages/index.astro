---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/home/hero-slider/HeroSlider.astro';
import { sliderData } from '../data/hero-slider';
import CategoryShowcase from '../components/home/category-showcase/CategoryShowcase.astro';
import { showcaseData } from '../data/showcase';
import FeaturedProductsTabs from '../components/home/featured-products/FeaturedProductsTabs.astro';
import tabsData from '../../assets/tabsData.json';
import type { FeaturedCategory } from '../types/featured-products';
import PromotionsShowcase from '../components/home/promotions/PromotionsShowcase.astro';
import { stocksListData } from '../data/promotions';
import Advantages from '../components/home/advantages/Advantages.astro';
import { advantagesData } from '../data/advantages';
import CompletedWorks from '../components/home/completed-works/CompletedWorks.astro';
import BrandsSlider from '../components/home/brands/BrandsSlider.astro';
import ArticlesList from '../components/home/articles/ArticlesList.astro';
---
<BaseLayout title="Печной Центр — печи, камины и материалы" description="Печи, камины, дымоходы и материалы для строительства и монтажа. Товары производителей и статьи Печного центра.">
  <h1 class="visually-hidden">Печной Центр — печи, камины и материалы</h1>
  <HeroSlider slides={sliderData} autoplay />
  <CategoryShowcase items={showcaseData} />
  <FeaturedProductsTabs categories={tabsData as FeaturedCategory[]} maxProducts={10} />
  <PromotionsShowcase title="Акции и скидки" items={stocksListData} allPromotionsUrl="#" maxItems={4} />
  <Advantages items={advantagesData} />
  <CompletedWorks />
  <BrandsSlider />
  <ArticlesList />
</BaseLayout>
