---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroShowcase from '../components/home/hero-slider/HeroShowcase.astro';
import { sliderData } from '../data/hero-slider';
import bannerData from '../../assets/slider-banners.json';
import WorkExample from '../components/articles/WorkExample.astro'
---
<BaseLayout title="Hero Slider с баннерами — Pechnik.su" description="Демонстрационный вариант Hero Slider: Fade, Parallax и четыре рекламных баннера.">
  <h1 class="visually-hidden">Hero Slider с рекламными баннерами</h1>
  <HeroShowcase slides={sliderData} banners={bannerData} />
  <div class="container">
  <WorkExample />

  <div class="aboutus_img-wrap">
    <a class="aboutus_img-link shine" href="https://www.pechnik.su/about/img/img_galery/o_pechnik_1.jpg" data-fancybox="yasenevo-gallery" data-caption="Печной Центр Ясенево" aria-label="Открыть фото: Печной Центр Ясенево"> 
      <img alt="Печной Центр Ясенево" src="https://www.pechnik.su/about/img/img_galery/o_pechnik_1.jpg" class="aboutus_img" loading="lazy" decoding="async">
    </a> 
    <a class="aboutus_img-link shine" href="https://www.pechnik.su/about/img/img_galery/o_pechnik_2.jpg"  data-fancybox="yasenevo-gallery" data-caption="Каминная галеря Печного Центра" aria-label="Открыть фото: Каминная галеря Печного Центра"> 
      <img alt="Каминная галеря Печного Центра" src="https://www.pechnik.su/about/img/img_galery/o_pechnik_2.jpg" class="aboutus_img" loading="lazy" decoding="async">
    </a>
    <a class="aboutus_img-link shine" href="https://www.pechnik.su/about/img/img_galery/o_pechnik_3.jpg" data-fancybox="yasenevo-gallery" data-caption="Вход в каминную галерею Печного Центра" aria-label="Открыть фото: Вход в каминную галерею Печного Центра">  
      <img alt="Вход в каминную галерею Печного Центра" src="https://www.pechnik.su/about/img/img_galery/o_pechnik_3.jpg" class="aboutus_img" loading="lazy" decoding="async">
    </a> 
    <a class="aboutus_img-link shine" href="https://www.pechnik.su/about/img/img_galery/o_pechnik_4.jpg" data-fancybox="yasenevo-gallery" data-caption="Склад материалов для строительства печей" aria-label="Открыть фото: Склад материалов для строительства печей">  
      <img alt="Склад материалов для строительства печей" src="https://www.pechnik.su/about/img/img_galery/o_pechnik_4.jpg" class="aboutus_img" loading="lazy" decoding="async">
    </a> 
  </div>

  </div>
</BaseLayout>
