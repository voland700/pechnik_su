<div class="catalog-sorting">
  <div class="catalog-sorting__group">
    <label for="sortSelected">Сортировать:</label>
    <select class="catalog-sorting__select catalog-sorting__select--order" id="sortSelected" name="sortSelected">
      <option value="default" selected>По порядку</option>
      <option value="price_asc">По цене (возрастанию)</option>
      <option value="price_desc">По цене (убыванию)</option>
      <option value="name_asc">По названию (А - Я)</option>
      <option value="name_desc">По названию (Я - А)</option>
    </select>
  </div>
  <div class="catalog-sorting__group">
    <label for="sortCount">Показывать по:</label>
    <select class="catalog-sorting__select" id="sortCount" name="sortCount">
      <option value="12">12</option>
      <option value="24">24</option>
      <option value="32" selected>32</option>
      <option value="44">44</option>
      <option value="60">60</option>
      <option value="72">72</option>
    </select>
  </div>
</div>
