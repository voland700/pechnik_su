---
import RecommendedArticles, { type RecommendedArticle } from './RecommendedArticles.astro';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import ArticleGallery, { type GalleryImage } from './ArticleGallery.astro';
import type { BreadcrumbItem } from '../../types/breadcrumbs';
import type { CatalogNavigationItem } from '../../types/catalog';
interface Props {
  title: string;
  description: string;
  breadcrumbs: BreadcrumbItem[];
  navigation: CatalogNavigationItem[];
  image?: { src: string; alt: string; width?: number; height?: number };
  imagePosition?: 'wide' | 'left' | 'right';
  summary?: string;
  /** Trusted HTML from the CMS; sanitize at the CMS boundary. Alternatively use the default slot. */
  content?: string;
  gallery?: readonly GalleryImage[];
  galleryTitle?: string;
  recommendedArticles?: readonly RecommendedArticle[];
}
const { title, description, breadcrumbs, navigation, image, imagePosition = 'wide', summary, content, gallery = [], galleryTitle = 'Галерея изображений', recommendedArticles = [] } = Astro.props;
---
<CatalogLayout title={`${title} — Pechnik.su`} heading={title} description={description} breadcrumbs={breadcrumbs} navigation={navigation}>
  <article class:list={['article-detail', `article-detail--${image ? `image-${imagePosition}` : 'no-image'}`]} aria-label={title}>
    {image && <div class="article-detail__image"><img src={image.src} alt={image.alt} width={image.width} height={image.height} fetchpriority="high" decoding="async" /></div>}
    {summary && <div class="article-detail__summary">{summary}</div>}
    <div class="article-content">
      {content !== undefined ? <Fragment set:html={content} /> : <slot />}
      {gallery.length > 0 && <><h2>{galleryTitle}</h2><ArticleGallery images={gallery} /></>}
    </div>
  </article>
  <RecommendedArticles articles={recommendedArticles} />
  <p class="article-detail__back"><a href={`${import.meta.env.BASE_URL}article/`}>Возврат к списку</a></p>
</CatalogLayout>
